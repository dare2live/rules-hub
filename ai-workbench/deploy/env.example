# /etc/ai-workbench/env
# systemd EnvironmentFile 格式：KEY=VALUE，不要写 export，值里有空格要加引号

FRIEND_CODE=friend-a,friend-b
ADMIN_CODE=change-me-admin
SESSION_SECRET=change-me-32-random-chars

CF_ACCOUNT_ID=你的32位account id
CF_GATEWAY_ID=ai-workbench
CF_API_TOKEN=只勾 Account Analytics Read

# 这三项在 Cloudflare 上是 wrangler.toml 的 [vars]，Node 下必须显式给
GOOGLE_API_VERSION=v1beta
RATE_LIMIT_PER_HOUR=80

ANTHROPIC_API_KEY=sk-ant-xxxx
GOOGLE_API_KEY=AIzaSyxxxx

# 可选
CF_AIG_TOKEN=
COST_ANTHROPIC_IN=
COST_ANTHROPIC_OUT=
COST_GOOGLE_IN=
COST_GOOGLE_OUT=
SYSTEM_PROMPT=
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_WEBHOOK_SECRET=

# 本机监听（只给 Caddy 回源，不要改成 0.0.0.0）
HOST=127.0.0.1
PORT=8787
